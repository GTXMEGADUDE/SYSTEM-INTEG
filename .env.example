APP_NAME="AniBayan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Laragon's MySQL: port 3306, user root, no password. Create the "anibayan" database, then run
# php artisan migrate --seed to make the tables and load the starting data.
# AniBayan's database is Supabase (Postgres), reached through its Session pooler (IPv4). Supabase → Connect →
# Session pooler shows these values; the password is the project's database password (never commit it).
DB_CONNECTION=pgsql
DB_HOST=aws-1-eu-west-3.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.kteeanqfarwwptpvvqxh
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# PayMongo test keys (Developers → API keys). Card and GCash checkout needs the secret key.
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=
# Public https folder with the crop photos for PayMongo's checkout when the site itself isn't on https.
PAYMONGO_IMAGE_URL=https://raw.githubusercontent.com/GTXMEGADUDE/SYSTEM-INTEG/main/public/anibayan/assets
